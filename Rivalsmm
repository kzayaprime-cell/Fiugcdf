--============ HELPERS ============
local function TG(tab, name, flag, desc)
    tab:CreateToggle({
        Name = name, Description = desc or "", Default = Moka[flag], Flag = flag,
        Callback = function(v) Moka[flag] = v end
    })
end
local function SL(tab, name, mn, mx, def, sfx, flag, dec)
    tab:CreateSlider({
        Name = name, Min = mn, Max = mx, Default = def,
        Suffix = sfx or "", Decimals = dec, Flag = flag,
        Callback = function(v) Moka[flag] = v end
    })
end
local function DD(tab, name, opts, def, flag)
    tab:CreateDropdown({
        Name = name, Options = opts, Default = def, Flag = flag,
        Callback = function(v) Moka[flag] = v end
    })
end
local function CP(tab, name, def, flag)
    tab:CreateColorPicker({
        Name = name, Default = def, Flag = flag,
        Callback = function(v) Moka[flag] = v end
    })
end
local function KB(tab, name, def, flag)
    tab:CreateKeybind({
        Name = name, Default = def, HoldToInteract = true, Flag = flag,
        Callback = function(v) Moka[flag] = v end
    })
end

