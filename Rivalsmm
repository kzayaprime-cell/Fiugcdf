--============ SPLASH ============
local function splash()
    local sg = Instance.new("ScreenGui")
    sg.Name = "MokaRV_Splash"
    sg.ResetOnSpawn = false
    sg.IgnoreGuiInset = true
    sg.DisplayOrder = 999
    sg.Parent = game.CoreGui

    local bg = Instance.new("Frame", sg)
    bg.Size = UDim2.fromScale(1,1)
    bg.BackgroundColor3 = Color3.fromRGB(10,10,14)
    bg.BackgroundTransparency = 1
    bg.BorderSizePixel = 0

    local title = Instance.new("TextLabel", bg)
    title.Size = UDim2.new(1,0,0,60)
    title.Position = UDim2.new(0,0,0.38,0)
    title.BackgroundTransparency = 1
    title.Text = BRAND
    title.Font = Enum.Font.GothamBold
    title.TextSize = 42
    title.TextColor3 = Color3.fromRGB(167,139,250)
    title.TextTransparency = 1

    local sub = Instance.new("TextLabel", bg)
    sub.Size = UDim2.new(1,0,0,20)
    sub.Position = UDim2.new(0,0,0.38,55)
    sub.BackgroundTransparency = 1
    sub.Text = "by " .. AUTHOR .. "  ·  " .. ENV.Platform
    sub.Font = Enum.Font.Gotham
    sub.TextSize = 14
    sub.TextColor3 = Color3.fromRGB(180,180,200)
    sub.TextTransparency = 1

    local cred = Instance.new("TextLabel", bg)
    cred.Size = UDim2.new(1,0,0,16)
    cred.Position = UDim2.new(0,0,0.38,78)
    cred.BackgroundTransparency = 1
    cred.Text = CREDITS
    cred.Font = Enum.Font.Gotham
    cred.TextSize = 12
    cred.TextColor3 = Color3.fromRGB(140,140,170)
    cred.TextTransparency = 1

    Tween:Create(bg, TweenInfo.new(0.3), {BackgroundTransparency=0}):Play()
    Tween:Create(title, TweenInfo.new(0.4), {TextTransparency=0}):Play()
    Tween:Create(sub, TweenInfo.new(0.5), {TextTransparency=0}):Play()
    Tween:Create(cred, TweenInfo.new(0.6), {TextTransparency=0}):Play()

    task.delay(1.6, function()
        Tween:Create(bg, TweenInfo.new(0.4), {BackgroundTransparency=1}):Play()
        Tween:Create(title, TweenInfo.new(0.3), {TextTransparency=1}):Play()
        Tween:Create(sub, TweenInfo.new(0.3), {TextTransparency=1}):Play()
        Tween:Create(cred, TweenInfo.new(0.3), {TextTransparency=1}):Play()
        task.wait(0.5)
        sg:Destroy()
    end)
end
splash()

