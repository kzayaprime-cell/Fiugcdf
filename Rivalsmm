--============ RESPONSIVE SIZE ============
local function computeSize()
    local vp = Camera.ViewportSize
    local w, h
    if ENV.Platform == "Mobile" then
        w = math.min(vp.X * 0.95, 420)
        h = math.min(vp.Y * 0.85, 620)
    elseif ENV.Platform == "Tablet" then
        w = math.min(vp.X * 0.75, 560)
        h = math.min(vp.Y * 0.80, 680)
    else
        w = math.min(vp.X * 0.45, 660)
        h = math.min(vp.Y * 0.75, 500)
    end
    return UDim2.fromOffset(w, h)
end

